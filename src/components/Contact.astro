---
import { getDict, type Locale } from '~/i18n';
import { contactEmail } from '~/lib/settings';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDict(locale);
const email = contactEmail;
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="rule"></div>
    <div class="contact-inner">
      <p class="eyebrow">
        <span class="num">{dict.contact.num}</span>
        <span>{dict.contact.label}</span>
      </p>
      <div class="contact-body">
        <h2 class="contact-title" id="contact-title">{dict.contact.heading}</h2>
        {
          email ? (
            <a class="contact-email mono" href={`mailto:${email}`}>
              {email}
            </a>
          ) : (
            <p class="contact-pending">{dict.contact.pending}</p>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .contact-inner {
    padding-top: 40px;
    padding-bottom: 40px;
    display: grid;
    grid-template-columns: 336px minmax(0, 1fr);
    column-gap: 80px;
    align-items: baseline;
  }

  .contact-title {
    font-size: 28px;
    line-height: 34px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .contact-email {
    margin-top: 14px;
    display: inline-block;
    font-size: 15px;
    line-height: 22px;
    color: var(--blue);
    border-bottom: 1px solid var(--blue);
    padding-bottom: 2px;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .contact-email:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .contact-pending {
    margin-top: 12px;
    font-size: 14px;
    line-height: 22px;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .contact-inner {
      padding-top: 32px;
      padding-bottom: 32px;
      grid-template-columns: minmax(0, 1fr);
      row-gap: 20px;
    }

    .contact-title {
      font-size: 24px;
      line-height: 30px;
    }
  }
</style>
