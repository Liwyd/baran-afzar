---
import { getDict, type Locale } from '~/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDict(locale);
---

<section class="quote" aria-label={dict.quote.author}>
  <div class="container">
    <div class="rule quote-rule"></div>
    <figure class="quote-inner">
      <blockquote class="quote-text">
        <p>{dict.quote.text}</p>
      </blockquote>
      <figcaption class="quote-author mono">{dict.quote.author}</figcaption>
    </figure>
  </div>
</section>

<style>
  .quote-inner {
    padding-top: 24px;
  }

  .quote-text {
    font-size: 20px;
    line-height: 30px;
    font-weight: 500;
    color: var(--ink);
  }

  .quote-author {
    margin-top: 18px;
    font-size: 13px;
    line-height: 20px;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .quote-rule {
      display: none;
    }

    .quote-inner {
      padding-top: 0;
    }

    .quote-text {
      font-size: 16px;
      line-height: 26px;
    }

    .quote-author {
      margin-top: 16px;
    }
  }
</style>
