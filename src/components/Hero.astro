---
import { getDict, type Locale } from '~/i18n';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDict(locale);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-main">
        <p class="eyebrow">
          <span class="num">{dict.hero.eyebrowNum}</span>
          <span>{dict.hero.eyebrowLabel}</span>
        </p>

        <h1 class="hero-title" id="hero-title">
          {dict.hero.headline[0]}
          <br />
          {dict.hero.headline[1]}
        </h1>

        <p class="hero-sub">{dict.hero.sub}</p>

        <a class="btn-primary" href="#people">
          <span>{dict.hero.cta}</span>
          <Icon name="arrow-right" size={13.155} />
        </a>
      </div>

      <div class="hero-aside">
        <div class="caret" aria-hidden="true">
          <span class="caret-bar caret-bar--long"></span>
          <span class="caret-bar caret-bar--short"></span>
        </div>
        <p class="hero-intro">{dict.hero.intro}</p>
      </div>
    </div>

    <div class="rule rule--blue hero-rule"></div>
  </div>
</section>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 896fr) minmax(0, 288fr);
    column-gap: 96px;
    align-items: end;
    padding-top: 75px;
  }

  .hero-main {
    min-width: 0;
  }

  .hero-title {
    margin-top: 29px;
    font-size: 90px;
    line-height: 96px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .hero-sub {
    margin-top: 30px;
    font-size: 20px;
    line-height: 30px;
    color: var(--muted);
  }

  .btn-primary {
    margin-top: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    width: 209px;
    height: 48px;
    background: var(--blue);
    color: var(--on-blue);
    font-size: 15px;
    line-height: 20px;
    font-weight: 500;
    transition: background-color 0.15s ease;
  }

  .btn-primary:hover {
    background: #12329a;
  }

  .btn-primary :global(svg) {
    flex: none;
  }

  .hero-aside {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .caret {
    display: flex;
    align-items: flex-end;
    gap: 8px;
  }

  .caret-bar {
    display: block;
    width: 3px;
    background: var(--blue);
    animation: caret-blink 1.1s steps(1, end) infinite;
  }

  .caret-bar--long {
    height: 36px;
  }

  .caret-bar--short {
    height: 24px;
    animation-delay: 0.15s;
  }

  @keyframes caret-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  .hero-intro {
    margin-top: 27px;
    font-size: 16px;
    line-height: 26px;
    color: var(--muted);
  }

  .hero-rule {
    margin-top: 64px;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 49px;
      padding-top: 40px;
    }

    .hero-title {
      margin-top: 26px;
      font-size: 50px;
      line-height: 53px;
      letter-spacing: -0.01em;
    }

    .hero-sub {
      margin-top: 31px;
      font-size: 16px;
      line-height: 25px;
    }

    .btn-primary {
      margin-top: 32px;
    }

    .hero-intro {
      margin-top: 33px;
      line-height: 25px;
    }

    .hero-rule {
      margin-top: 43px;
    }
  }
</style>
