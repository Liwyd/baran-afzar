---
import { getDict, type Locale } from '~/i18n';
import logoLarge from '~/assets/logo-en.svg';
import logoSmall from '~/assets/logo-en-sm.svg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDict(locale);

const navItems = [
  { href: '#approach', label: dict.nav.approach },
  { href: '#capabilities', label: dict.nav.capabilities },
  { href: '#people', label: dict.nav.people },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Baran Afzar">
      <picture>
        <source media="(max-width: 900px)" srcset={logoSmall} />
        <img src={logoLarge} alt="" width="174.387" height="32" />
      </picture>
    </a>

    <nav class="site-nav" aria-label="Primary">
      {
        navItems.map((item) => (
          <a href={item.href}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="lang-switch" dir="ltr">
      <a href="/" lang="en" hreflang="en" aria-current={locale === 'en' ? 'page' : undefined}>
        {dict.footer.lang.en}
      </a>
      <span class="lang-sep" aria-hidden="true">/</span>
      <a href="/fa" lang="fa" hreflang="fa" aria-current={locale === 'fa' ? 'page' : undefined}>
        {dict.footer.lang.fa}
      </a>
    </div>

    <div class="rule rule--header"></div>
  </div>
</header>

<style>
  .site-header {
    padding-top: 0;
  }

  .header-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-rows: var(--header-h) auto;
    grid-template-areas:
      'brand nav lang'
      'rule rule rule';
    align-items: center;
  }

  .brand {
    grid-area: brand;
    display: block;
    line-height: 0;
  }

  .brand img {
    display: block;
  }

  .site-nav {
    grid-area: nav;
    justify-self: center;
    display: flex;
    gap: 34px;
    font-size: 15px;
    line-height: 20px;
    letter-spacing: var(--track-nav);
    color: var(--ink);
  }

  .site-nav a {
    transition: color 0.15s ease;
  }

  .site-nav a:hover {
    color: var(--blue);
  }

  .lang-switch {
    grid-area: lang;
    justify-self: end;
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: 15px;
    line-height: 20px;
    color: var(--muted);
    white-space: nowrap;
  }

  .lang-switch a {
    transition: color 0.15s ease;
  }

  .lang-switch a:hover {
    color: var(--ink);
  }

  .lang-switch a[aria-current='page'] {
    color: var(--blue);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .lang-switch a[aria-current='page']:hover {
    color: var(--blue);
  }

  .lang-sep {
    color: var(--muted);
  }

  .rule--header {
    grid-area: rule;
  }

  @media (max-width: 900px) {
    .header-inner {
      grid-template-columns: auto 1fr;
      grid-template-rows: var(--header-h) auto auto;
      grid-template-areas:
        'brand lang'
        'rule rule'
        'nav nav';
    }

    .site-nav {
      justify-self: start;
      gap: 28px;
      padding-top: 17px;
    }
  }
</style>
