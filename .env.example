# --- Runtime -------------------------------------------------------------

# Public origin used for canonical URLs, Open Graph and sitemap.
# In production this is the real https:// domain.
PUBLIC_ORIGIN=http://127.0.0.1:4321

# Private mount point for the administration dashboard.
# This is *discretion, not security* — access is enforced server-side by
# session authentication regardless of this path. Change it to something
# non-obvious; it must start with "/" and be 4–64 characters long.
ADMIN_PATH=/admin-8f3c2a

# Absolute path (or ./data) where SQLite and uploaded résumés live.
# Must be on persistent storage in production — never inside the build output.
BARAN_DATA_DIR=./data

# --- Local development conveniences ---------------------------------------

# Allow the session cookie to be issued without the Secure attribute.
# Only for http://127.0.0.1 development. Never set in production.
ALLOW_INSECURE_COOKIES=true

# NODE_ENV is normally set by the runtime (production | development).
